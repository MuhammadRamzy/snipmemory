{
  "name": "snipmemory",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "npm run build && vite preview",
    "deploy": "npm run build && wrangler deploy",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply snipmemory --local",
    "db:migrate:remote": "wrangler d1 migrations apply snipmemory --remote",
    "cf-typegen": "wrangler types worker/worker-configuration.d.ts",
    "seed:demo": "node scripts/seed-demo.mjs"
  },
  "dependencies": {
    "hono": "^4.13.13",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router": "^7.18.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.64.0",
    "@cloudflare/vitest-plugin": "^1.4.5",
    "@cloudflare/workers-types": "^5.20261019.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "4.1.12",
    "wrangler": "^4.151.2"
  }
}
