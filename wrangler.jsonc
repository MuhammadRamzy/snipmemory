{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "snipmemory",
  "main": "worker/src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  // The React app (web/) is built by Vite and served as static assets.
  // API routes always hit the Worker first; every other path falls back to the SPA.
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "snipmemory",
      // Create with: npx wrangler d1 create snipmemory  — then paste the id here.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    // Create with: npx wrangler r2 bucket create snipmemory-media
    { "binding": "MEDIA", "bucket_name": "snipmemory-media" }
  ],
  // Nightly cleanup (03:00 IST).
  "triggers": { "crons": ["30 21 * * *"] },
  "vars": {
    "APP_ENV": "development",
    "APP_URL": "http://localhost:5173",
    "PLATFORM_UPI_VPA": "snipmemory@okicici",
    "PLATFORM_UPI_NAME": "SnipMemory",
    "SUPPORT_WHATSAPP": "919000000000"
  },
  // No secrets needed: there is no payment gateway or SMS provider.
  "observability": { "enabled": true },

  // Production: build with `CLOUDFLARE_ENV=production npm run build`, then `npx wrangler deploy`.
  // Bindings are not inherited by environments, so they are declared again here.
  "env": {
    "production": {
      "name": "snipmemory",
      "routes": [{ "pattern": "snipmemory.app", "custom_domain": true }],
      "d1_databases": [
        { "binding": "DB", "database_name": "snipmemory", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" }
      ],
      "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "snipmemory-media" }],
      "triggers": { "crons": ["30 21 * * *"] },
      "vars": {
        "APP_ENV": "production",
        "APP_URL": "https://snipmemory.app",
        "PLATFORM_UPI_VPA": "REPLACE_ME@upi",
        "PLATFORM_UPI_NAME": "SnipMemory",
        "SUPPORT_WHATSAPP": "91XXXXXXXXXX"
      }
    }
  }
}
